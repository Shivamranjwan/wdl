\pard\sb240\sa100\cf2\b\fs24 Step 6: Run the PL/SQL Block\par

\pard\sb60\sa60\cf0\b0\fs22 Copy and paste the complete PL/SQL code below. Change the roll number in v_roll := 101; to test different students.\par

\pard\sb80\par
\trowd\trgaph200\trrh1\trpaddl200\trpaddr200\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat25\clbrdrl\brdrw16\brdrs\brdrcf2\clbrdrt\brdrw8\brdrs\brdrcf2\clbrdrr\brdrw8\brdrs\brdrcf2\clbrdrb\brdrw8\brdrs\brdrcf2 \cellx9360 
\pard\intbl\sb20\sa20\cf12\f2\fs20 SET SERVEROUTPUT ON;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 DECLARE\cf0\f0\fs22\par
\cf12\f2\fs20     v_roll   Stud.Roll%TYPE;\cf0\f0\fs22\par
\cf12\f2\fs20     v_att    Stud.Att%TYPE;\cf0\f0\fs22\par
\cf12\f2\fs20 BEGIN\cf0\f0\fs22\par
\cf12\f2\fs20     v_roll := 101;  -- Change to 101, 102, or 103\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     SELECT Att INTO v_att\cf0\f0\fs22\par
\cf12\f2\fs20     FROM Stud\cf0\f0\fs22\par
\cf12\f2\fs20     WHERE Roll = v_roll;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     IF v_att < 75 THEN\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE('Term not granted');\cf0\f0\fs22\par
\cf12\f2\fs20         UPDATE Stud SET Status = 'D' WHERE Roll = v_roll;\cf0\f0\fs22\par
\cf12\f2\fs20     ELSE\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE('Term granted');\cf0\f0\fs22\par
\cf12\f2\fs20         UPDATE Stud SET Status = 'ND' WHERE Roll = v_roll;\cf0\f0\fs22\par
\cf12\f2\fs20     END IF;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     COMMIT;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 EXCEPTION\cf0\f0\fs22\par
\cf12\f2\fs20     WHEN NO_DATA_FOUND THEN\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE('Error: Roll number not found.');\cf0\f0\fs22\par
\cf12\f2\fs20     WHEN TOO_MANY_ROWS THEN\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE('Error: Duplicate roll numbers exist.');\cf0\f0\fs22\par
\cf12\f2\fs20     WHEN OTHERS THEN\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE('Unexpected error: ' || SQLERRM);\cf0\f0\fs22\par
\cf12\f2\fs20 END;\cf0\f0\fs22\par
\cf12\f2\fs20 /\cf0\f3\fs22\cell\row 
