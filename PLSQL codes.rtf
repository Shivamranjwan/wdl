\par

\pard\sb280\sa160\cf1\b\fs32 1. Problem Statement\par

\pard\sa120\cf0\b0\fs22 Database Trigger (Row Level, Before Trigger). Write a database trigger on the Library table. The system should keep track of records that are being updated or deleted. The old values of updated or deleted records should be added into the Library_Audit table.\par

\pard\sa80\par

\pard\sb200\sa120\cf2\b\fs26 1.1 Schema\par

\pard\sa100\cf0\fs22 Main Table: \b0 Library(Book_id, Book_name, Author, Quantity, Price)\par
\b Audit Table: \b0 Library_Audit(Book_id, Book_name, Author, Quantity, Price, Operation, Changed_on)\par

\pard\sa80\par

\pard\sb200\sa120\cf2\b\fs26 1.2 Requirements\par

\pard{\pntext\f8\'B7\tab}{\*\pn\pnlvlblt\pnf8\pnindent360{\pntxtb\'B7}}\fi-360\li720\sa100\cf0\b0\fs22 Create a BEFORE trigger on the Library table.\par
{\pntext\f8\'B7\tab}Trigger fires on UPDATE or DELETE operations \f1\emdash  \f0 row level.\par
{\pntext\f8\'B7\tab}Before any update or delete, the OLD values are saved into Library_Audit.\par
{\pntext\f8\'B7\tab}The Operation column in audit table stores 'UPDATE' or 'DELETE'.\par
{\pntext\f8\'B7\tab}Changed_on column stores the timestamp of when the change happened.\par

\pard\sa80\par

\pard\sb280\sa160\cf1\b\fs32 2. Concept Overview\par

\pard\sa80\cf0\b0\fs22\par
\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat1\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx2480\clcfpat13\clcbpat1\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\cf6\b\fs20 Term\cf0\b0\f3\fs22\cell\cf6\b\f0\fs20 Explanation\cf0\b0\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx2480\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 Trigger\f3\fs22\cell\f0\fs20 A stored PL/SQL block that fires automatically on DML events (INSERT, UPDATE, DELETE).\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx2480\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 Row Level Trigger\f3\fs22\cell\f0\fs20 Fires once for each row affected by the DML operation. Uses FOR EACH ROW clause.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx2480\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 Before Trigger\f3\fs22\cell\f0\fs20 Fires before the actual DML operation executes on the table.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx2480\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 :OLD\f3\fs22\cell\f0\fs20 Refers to the original value of the column before UPDATE or DELETE.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx2480\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 :NEW\f3\fs22\cell\f0\fs20 Refers to the new value being set during INSERT or UPDATE.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx2480\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 Audit Trail\f3\fs22\cell\f0\fs20 A log of all changes made to a table, stored in a separate audit table.\f3\fs22\cell\row 
\pard\sa80\f0\par

\pard\sb280\sa160\cf1\b\fs32 3. Step 1 \f1\endash  \f0 Create Tables\par

\pard\sa120\cf0\b0\fs22 Run both CREATE statements before writing the trigger.\par

\pard\sa80\par

\pard\li360\cf3\highlight4\f2\fs18 -- Main Library table\cf0\f0\fs22\par
\cf3\f2\fs18 CREATE TABLE Library (\cf0\f0\fs22\par
\cf3\f2\fs18     Book_id    NUMBER PRIMARY KEY,\cf0\f0\fs22\par
\cf3\f2\fs18     Book_name  VARCHAR2(100),\cf0\f0\fs22\par
\cf3\f2\fs18     Author     VARCHAR2(100),\cf0\f0\fs22\par
\cf3\f2\fs18     Quantity   NUMBER,\cf0\f0\fs22\par
\cf3\f2\fs18     Price      NUMBER\cf0\f0\fs22\par
\cf3\f2\fs18 );\cf0\f0\fs22\par
\par
\cf3\f2\fs18 -- Audit table to store old values\cf0\f0\fs22\par
\cf3\f2\fs18 CREATE TABLE Library_Audit (\cf0\f0\fs22\par
\cf3\f2\fs18     Book_id    NUMBER,\cf0\f0\fs22\par
\cf3\f2\fs18     Book_name  VARCHAR2(100),\cf0\f0\fs22\par
\cf3\f2\fs18     Author     VARCHAR2(100),\cf0\f0\fs22\par
\cf3\f2\fs18     Quantity   NUMBER,\cf0\f0\fs22\par
\cf3\f2\fs18     Price      NUMBER,\cf0\f0\fs22\par
\cf3\f2\fs18     Operation  VARCHAR2(10),\cf0\f0\fs22\par
\cf3\f2\fs18     Changed_on DATE\cf0\f0\fs22\par
\cf3\f2\fs18 );\cf0\f0\fs22\par

\pard\sa80\highlight0\par

\pard\sb280\sa160\cf1\b\fs32 4. Step 2 \f1\endash  \f0 Insert Sample Data\par

\pard\li360\cf3\highlight4\b0\f2\fs18 INSERT INTO Library VALUES (1, 'DBMS',              'Ramakrishnan',  10, 450);\cf0\f0\fs22\par
\cf3\f2\fs18 INSERT INTO Library VALUES (2, 'Operating Systems', 'Galvin',         5, 600);\cf0\f0\fs22\par
\cf3\f2\fs18 INSERT INTO Library VALUES (3, 'Computer Networks', 'Forouzan',       8, 520);\cf0\f0\fs22\par
\cf3\f2\fs18 INSERT INTO Library VALUES (4, 'Data Structures',   'Lipschutz',     12, 380);\cf0\f0\fs22\par
\cf3\f2\fs18 COMMIT;\cf0\f0\fs22\par

\pard\sa80\highlight0\par

\pard\sb280\sa160\cf1\b\fs32 5. Step 3 \f1\endash  \f0 Create the BEFORE Trigger\par

\pard\sa120\cf0\b0\fs22 This trigger fires BEFORE every UPDATE or DELETE on the Library table and saves the old row into Library_Audit.\par

\pard\sa80\par

\pard\li360\cf3\highlight4\f2\fs18 CREATE OR REPLACE TRIGGER trg_library_audit\cf0\f0\fs22\par
\cf3\f2\fs18 BEFORE UPDATE OR DELETE\cf0\f0\fs22\par
\cf3\f2\fs18 ON Library\cf0\f0\fs22\par
\cf3\f2\fs18 FOR EACH ROW\cf0\f0\fs22\par
\cf3\f2\fs18 DECLARE\cf0\f0\fs22\par
\cf3\f2\fs18     v_operation VARCHAR2(10);\cf0\f0\fs22\par
\cf3\f2\fs18 BEGIN\cf0\f0\fs22\par
\cf3\f2\fs18     -- Identify which operation is happening\cf0\f0\fs22\par
\cf3\f2\fs18     IF DELETING THEN\cf0\f0\fs22\par
\cf3\f2\fs18         v_operation := 'DELETE';\cf0\f0\fs22\par
\cf3\f2\fs18     ELSIF UPDATING THEN\cf0\f0\fs22\par
\cf3\f2\fs18         v_operation := 'UPDATE';\cf0\f0\fs22\par
\cf3\f2\fs18     END IF;\cf0\f0\fs22\par
\par
\cf3\f2\fs18     -- Save OLD values into audit table before change happens\cf0\f0\fs22\par
\cf3\f2\fs18     INSERT INTO Library_Audit (\cf0\f0\fs22\par
\cf3\f2\fs18         Book_id, Book_name, Author,\cf0\f0\fs22\par
\cf3\f2\fs18         Quantity, Price, Operation, Changed_on\cf0\f0\fs22\par
\cf3\f2\fs18     ) VALUES (\cf0\f0\fs22\par
\cf3\f2\fs18         :OLD.Book_id,\cf0\f0\fs22\par
\cf3\f2\fs18         :OLD.Book_name,\cf0\f0\fs22\par
\cf3\f2\fs18         :OLD.Author,\cf0\f0\fs22\par
\cf3\f2\fs18         :OLD.Quantity,\cf0\f0\fs22\par
\cf3\f2\fs18         :OLD.Price,\cf0\f0\fs22\par
\cf3\f2\fs18         v_operation,\cf0\f0\fs22\par
\cf3\f2\fs18         SYSDATE\cf0\f0\fs22\par
\cf3\f2\fs18     );\cf0\f0\fs22\par
\par
\cf3\f2\fs18     DBMS_OUTPUT.PUT_LINE('Audit log saved for Book_id: ' || :OLD.Book_id);\cf0\f0\fs22\par
\cf3\f2\fs18     DBMS_OUTPUT.PUT_LINE('Operation: ' || v_operation);\cf0\f0\fs22\par
\par
\cf3\f2\fs18 EXCEPTION\cf0\f0\fs22\par
\cf3\f2\fs18     WHEN OTHERS THEN\cf0\f0\fs22\par
\cf3\f2\fs18         DBMS_OUTPUT.PUT_LINE('Trigger error: ' || SQLERRM);\cf0\f0\fs22\par
\cf3\f2\fs18 END;\cf0\f0\fs22\par
\cf3\f2\fs18 /\cf0\f0\fs22\par

\pard\sa80\highlight0\par

\pard\sb280\sa160\cf1\b\fs32 6. Step 4 \f1\endash  \f0 Test the Trigger\par

\pard\sa80\cf0\b0\fs22\par

\pard\sb200\sa120\cf2\b\fs26 6.1 Test UPDATE\par

\pard\sa120\cf0\b0\fs22 Update the price of Book_id = 1. Trigger will save old price to audit table before updating.\par

\pard\sa80\par

\pard\li360\cf3\highlight4\f2\fs18 UPDATE Library\cf0\f0\fs22\par
\cf3\f2\fs18 SET    Price = 500\cf0\f0\fs22\par
\cf3\f2\fs18 WHERE  Book_id = 1;\cf0\f0\fs22\par
\cf3\f2\fs18 COMMIT;\cf0\f0\fs22\par

\pard\sa80\highlight0\par

\pard\sb200\sa120\cf2\b\fs26 6.2 Test DELETE\par

\pard\sa120\cf0\b0\fs22 Delete Book_id = 4. Trigger will save entire old row to audit table before deleting.\par

\pard\sa80\par

\pard\li360\cf3\highlight4\f2\fs18 DELETE FROM Library\cf0\f0\fs22\par
\cf3\f2\fs18 WHERE  Book_id = 4;\cf0\f0\fs22\par
\cf3\f2\fs18 COMMIT;\cf0\f0\fs22\par

\pard\sa80\highlight0\par

\pard\sb280\sa160\cf1\b\fs32 7. Step 5 \f1\endash  \f0 Verify Output\par

\pard\li360\cf3\highlight4\b0\f2\fs18 -- Check current Library table\cf0\f0\fs22\par
\cf3\f2\fs18 SELECT * FROM Library;\cf0\f0\fs22\par
\par
\cf3\f2\fs18 -- Check audit trail (old values saved by trigger)\cf0\f0\fs22\par
\cf3\f2\fs18 SELECT * FROM Library_Audit;\cf0\f0\fs22\par

\pard\sa80\highlight0\par

