\pard\sb240\sa80\cf2\b\fs24 Step 7 \f1\emdash  \f0 Call the Procedure using PL/SQL Block\par

\pard\sb60\sa60\cf0\b0\fs22 This block loops through all students, calls proc_Grade for each one, and prints the result:\par

\pard\sb60\par
\trowd\trgaph200\trrh1\trpaddl200\trpaddr200\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat25\clbrdrl\brdrw20\brdrs\brdrcf2\clbrdrt\brdrw8\brdrs\brdrcf2\clbrdrr\brdrw8\brdrs\brdrcf2\clbrdrb\brdrw8\brdrs\brdrcf2 \cellx9360 
\pard\intbl\sb20\sa20\cf12\f2\fs20 SET SERVEROUTPUT ON;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 DECLARE\cf0\f0\fs22\par
\cf12\f2\fs20     v_class  VARCHAR2(30);\cf0\f0\fs22\par
\cf12\f2\fs20     v_roll   NUMBER := 1;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 BEGIN\cf0\f0\fs22\par
\cf12\f2\fs20     -- Loop through all students in Stud_Marks\cf0\f0\fs22\par
\cf12\f2\fs20     FOR rec IN (SELECT Name, Total_Marks FROM Stud_Marks) LOOP\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20         -- Call the stored procedure\cf0\f0\fs22\par
\cf12\f2\fs20         proc_Grade(rec.Name, rec.Total_Marks, v_roll, v_class);\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20         -- Print result\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE(\cf0\f0\fs22\par
\cf12\f2\fs20             'Roll: ' || v_roll ||\cf0\f0\fs22\par
\cf12\f2\fs20             ' | Name: '  || rec.Name ||\cf0\f0\fs22\par
\cf12\f2\fs20             ' | Marks: ' || rec.Total_Marks ||\cf0\f0\fs22\par
\cf12\f2\fs20             ' | Class: ' || v_class\cf0\f0\fs22\par
\cf12\f2\fs20         );\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20         v_roll := v_roll + 1;\cf0\f0\fs22\par
\cf12\f2\fs20     END LOOP;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 EXCEPTION\cf0\f0\fs22\par
\cf12\f2\fs20     WHEN OTHERS THEN\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);\cf0\f0\fs22\par
\cf12\f2\fs20 END;\cf0\f0\fs22\par
