\pard\sb400\sa200\qc\cf1\b\fs24\lang9 PL/SQL Practical \f1\endash\f0  Chit 2\cf0\b0\par

\pard\sa120\qc\cf2 Library Book Fine Management System\cf0\par

\pard\sb280\sa160\cf1\b\fs32 1. Problem Statement\par

\pard\sa120\cf0\b0\fs22 Unnamed PL/SQL code block with mandatory use of Control Structures and Exception Handling.\par

\pard\sa80\par

\pard\sb200\sa120\cf2\b\fs26 1.1 Schema\par

\pard\sa100\cf0\fs22 Table 1: \b0 Borrower(Rollin, Name, DateofIssue, NameofBook, Status)\par
\b Table 2: \b0 Fine(Roll_no, Date_, Amt)\par

\pard\sa80\par

\pard\sb200\sa120\cf2\b\fs26 1.2 Requirements\par

\pard{\pntext\f8\'B7\tab}{\*\pn\pnlvlblt\pnf8\pnindent360{\pntxtb\'B7}}\fi-360\li720\sa100\cf0\b0\fs22 Accept Roll_no and Name of Book from the user.\par
{\pntext\f8\'B7\tab}Check number of days from date of issue.\par
{\pntext\f8\'B7\tab}Days 15\f1\endash\f0 30: Fine = Rs 5 per day.\par
{\pntext\f8\'B7\tab}Days > 30: Rs 5/day for first 30 days + Rs 50/day for remaining days.\par
{\pntext\f8\'B7\tab}After submitting book, status changes from I (Issued) to R (Returned).\par
{\pntext\f8\'B7\tab}If fine > 0, insert record into Fine table.\par

\pard\sa80\par

\pard\sb280\sa160\cf1\b\fs32 2. Step 1 \f1\endash\f0  Create Tables\par

\pard\sa120\cf0\b0\fs22 Run the following SQL on Oracle Live SQL or any Oracle environment:\par

\pard\sa80\par

\pard\li360\cf3\highlight4\f2\fs18 CREATE TABLE Borrower (\cf0\f0\fs22\par
\cf3\f2\fs18     Rollin      NUMBER PRIMARY KEY,\cf0\f0\fs22\par
\cf3\f2\fs18     Name        VARCHAR2(50),\cf0\f0\fs22\par
\cf3\f2\fs18     DateofIssue DATE,\cf0\f0\fs22\par
\cf3\f2\fs18     NameofBook  VARCHAR2(100),\cf0\f0\fs22\par
\cf3\f2\fs18     Status      CHAR(1)\cf0\f0\fs22\par
\cf3\f2\fs18 );\cf0\f0\fs22\par
\par
\cf3\f2\fs18 CREATE TABLE Fine (\cf0\f0\fs22\par
\cf3\f2\fs18     Roll_no NUMBER,\cf0\f0\fs22\par
\cf3\f2\fs18     Date_   DATE,\cf0\f0\fs22\par
\cf3\f2\fs18     Amt     NUMBER\cf0\f0\fs22\par
\cf3\f2\fs18 );\cf0\f0\fs22\par

\pard\sa80\highlight0\par

\pard\sb280\sa160\cf1\b\fs32 3. Step 2 \f1\endash\f0  Insert Sample Data\par

\pard\li360\cf3\highlight4\b0\f2\fs18 INSERT INTO Borrower VALUES (101, 'Shivam', DATE '2025-04-01', 'DBMS', 'I');\cf0\f0\fs22\par
\cf3\f2\fs18 INSERT INTO Borrower VALUES (102, 'Riya',   DATE '2025-03-10', 'OS',   'I');\cf0\f0\fs22\par
\cf3\f2\fs18 COMMIT;\cf0\f0\fs22\par

\pard\sa80\highlight0\par

