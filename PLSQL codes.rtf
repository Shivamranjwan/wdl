\pard\intbl\sb20\sa20\cf12\f2\fs20 SET SERVEROUTPUT ON;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 DECLARE\cf0\f0\fs22\par
\cf12\f2\fs20     -- Parameterized Cursor Declaration\cf0\f0\fs22\par
\cf12\f2\fs20     CURSOR c_new(p_roll N_RollCall.Roll%TYPE) IS\cf0\f0\fs22\par
\cf12\f2\fs20         SELECT Roll, Name, Marks\cf0\f0\fs22\par
\cf12\f2\fs20         FROM N_RollCall\cf0\f0\fs22\par
\cf12\f2\fs20         WHERE Roll = p_roll;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     -- Variables\cf0\f0\fs22\par
\cf12\f2\fs20     v_roll    N_RollCall.Roll%TYPE;\cf0\f0\fs22\par
\cf12\f2\fs20     v_name    N_RollCall.Name%TYPE;\cf0\f0\fs22\par
\cf12\f2\fs20     v_marks   N_RollCall.Marks%TYPE;\cf0\f0\fs22\par
\cf12\f2\fs20     v_count   NUMBER;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 BEGIN\cf0\f0\fs22\par
\cf12\f2\fs20     -- Loop through every record in N_RollCall\cf0\f0\fs22\par
\cf12\f2\fs20     FOR rec IN (SELECT Roll FROM N_RollCall) LOOP\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20         -- Open parameterized cursor for each roll\cf0\f0\fs22\par
\cf12\f2\fs20         OPEN c_new(rec.Roll);\cf0\f0\fs22\par
\cf12\f2\fs20         FETCH c_new INTO v_roll, v_name, v_marks;\cf0\f0\fs22\par
\cf12\f2\fs20         CLOSE c_new;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20         -- Check if roll already exists in O_RollCall\cf0\f0\fs22\par
\cf12\f2\fs20         SELECT COUNT(*) INTO v_count\cf0\f0\fs22\par
\cf12\f2\fs20         FROM O_RollCall\cf0\f0\fs22\par
\cf12\f2\fs20         WHERE Roll = v_roll;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20         IF v_count = 0 THEN\cf0\f0\fs22\par
\cf12\f2\fs20             -- Not found: Insert into O_RollCall\cf0\f0\fs22\par
\cf12\f2\fs20             INSERT INTO O_RollCall VALUES (v_roll, v_name, v_marks);\cf0\f0\fs22\par
\cf12\f2\fs20             DBMS_OUTPUT.PUT_LINE('Inserted Roll: '||v_roll||' - '||v_name);\cf0\f0\fs22\par
\cf12\f2\fs20         ELSE\cf0\f0\fs22\par
\cf12\f2\fs20             -- Already exists: Skip\cf0\f0\fs22\par
\cf12\f2\fs20             DBMS_OUTPUT.PUT_LINE('Skipped Roll: '||v_roll||' - Already exists');\cf0\f0\fs22\par
\cf12\f2\fs20         END IF;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     END LOOP;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     COMMIT;\cf0\f0\fs22\par
\cf12\f2\fs20     DBMS_OUTPUT.PUT_LINE('Merge completed successfully!');\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 EXCEPTION\cf0\f0\fs22\par
\cf12\f2\fs20     WHEN OTHERS THEN\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);\cf0\f0\fs22\par
\cf12\f2\fs20 END;\cf0\f0\fs22\par
