\pard\sb280\sa160\cf1\b\fs32 8. How the Trigger Works (Flow)\par

\pard\sa80\cf0\b0\fs22\par
\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat1\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx1240\clcfpat13\clcbpat1\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\cf6\b\fs20 Step\cf0\b0\f3\fs22\cell\cf6\b\f0\fs20 What Happens\cf0\b0\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx1240\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 1\f3\fs22\cell\f0\fs20 User fires an UPDATE or DELETE on Library table.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx1240\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 2\f3\fs22\cell\f0\fs20 BEFORE trigger (trg_library_audit) activates for each affected row.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx1240\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 3\f3\fs22\cell\f0\fs20 :OLD values (original data) are captured before any change.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx1240\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 4\f3\fs22\cell\f0\fs20 Old values + operation type + timestamp are inserted into Library_Audit.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx1240\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 5\f3\fs22\cell\f0\fs20 Actual UPDATE or DELETE completes on Library table.\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx1240\clcfpat13\clcbpat6\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 6\f3\fs22\cell\f0\fs20 Audit table now holds a full history of all changes.\f3\fs22\cell\row 
\pard\sa80\f0\par

\pard\sb280\sa160\cf1\b\fs32 9. Key Points for Exam\par

\pard{\pntext\f8\'B7\tab}{\*\pn\pnlvlblt\pnf8\pnindent360{\pntxtb\'B7}}\fi-360\li720\sa100\cf0\b0\fs22 BEFORE trigger fires before the actual DML \f1\emdash  \f0 so :OLD values are still available.\par
{\pntext\f8\'B7\tab}FOR EACH ROW makes it a row-level trigger \f1\emdash  \f0 fires once per affected row.\par
{\pntext\f8\'B7\tab}DELETING and UPDATING are Oracle conditional predicates to identify the operation.\par
{\pntext\f8\'B7\tab}:OLD.column gives value before the change; :NEW.column gives the incoming value.\par
{\pntext\f8\'B7\tab}Exception handling with WHEN OTHERS ensures the trigger does not silently fail.\par
{\pntext\f8\'B7\tab}No COMMIT inside the trigger \f1\emdash  \f0 the outer DML transaction handles it.\par

\pard\sa80\par

