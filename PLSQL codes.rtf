\pard\intbl\f0\fs20 15 to 30\f3\fs22\cell\f0\fs20 days \'d7 Rs 5 per day\f3\fs22\cell\row\trowd\trgaph120\trrh1\trpaddl120\trpaddr120\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx3120\clcfpat13\clcbpat21\clbrdrl\brdrw2\brdrs\brdrcf19\clbrdrt\brdrw2\brdrs\brdrcf19\clbrdrr\brdrw2\brdrs\brdrcf19\clbrdrb\brdrw2\brdrs\brdrcf19 \cellx9360 
\pard\intbl\f0\fs20 Greater than 30\f3\fs22\cell\f0\fs20 (30 \'d7 Rs 5) + (extra days \'d7 Rs 50)\f3\fs22\cell\row 
