\pard\intbl\f0\fs20 More than 30 days\f3\fs22\cell\f0\fs20 DATE '2025-03-01'\f3\fs22\cell\row 
\pard\sa80\f0\par

\pard\sb280\sa160\cf1\b\fs32 4. Step 3 \f1\endash\f0  PL/SQL Block\par

\pard\sa120\cf0\b0\fs22 Paste this block and run it. Oracle will prompt for Roll No and Book Name at runtime.\par

\pard\sa80\par

\pard\li360\cf3\highlight4\f2\fs18 DECLARE\cf0\f0\fs22\par
\cf3\f2\fs18     v_rollin      Borrower.Rollin%TYPE      := &roll_no;\cf0\f0\fs22\par
\cf3\f2\fs18     v_bookname    Borrower.NameofBook%TYPE  := '&book_name';\cf0\f0\fs22\par
\par
\cf3\f2\fs18     v_dofissue    DATE;\cf0\f0\fs22\par
\cf3\f2\fs18     v_days        NUMBER;\cf0\f0\fs22\par
\cf3\f2\fs18     v_fine        NUMBER := 0;\cf0\f0\fs22\par
\cf3\f2\fs18 BEGIN\cf0\f0\fs22\par
\cf3\f2\fs18     -- Fetch issue date for given roll no and book\cf0\f0\fs22\par
\cf3\f2\fs18     SELECT DateofIssue\cf0\f0\fs22\par
\cf3\f2\fs18     INTO   v_dofissue\cf0\f0\fs22\par
\cf3\f2\fs18     FROM   Borrower\cf0\f0\fs22\par
\cf3\f2\fs18     WHERE  Rollin     = v_rollin\cf0\f0\fs22\par
\cf3\f2\fs18       AND  NameofBook = v_bookname\cf0\f0\fs22\par
\cf3\f2\fs18       AND  Status     = 'I';\cf0\f0\fs22\par
\par
\cf3\f2\fs18     -- Calculate days since issue\cf0\f0\fs22\par
\cf3\f2\fs18     v_days := TRUNC(SYSDATE) - TRUNC(v_dofissue);\cf0\f0\fs22\par
\par
\cf3\f2\fs18     DBMS_OUTPUT.PUT_LINE('Days since issue: ' || v_days);\cf0\f0\fs22\par
\par
\cf3\f2\fs18     -- Fine calculation\cf0\f0\fs22\par
\cf3\f2\fs18     IF v_days BETWEEN 15 AND 30 THEN\cf0\f0\fs22\par
\cf3\f2\fs18         v_fine := v_days * 5;\cf0\f0\fs22\par
\cf3\f2\fs18         DBMS_OUTPUT.PUT_LINE('Fine: ' || v_days || ' days x Rs 5 = Rs ' || v_fine);\cf0\f0\fs22\par
\par
\cf3\f2\fs18     ELSIF v_days > 30 THEN\cf0\f0\fs22\par
\cf3\f2\fs18         v_fine := (30 * 5) + ((v_days - 30) * 50);\cf0\f0\fs22\par
\cf3\f2\fs18         DBMS_OUTPUT.PUT_LINE('Fine: (30x5) + (' || (v_days-30) || 'x50) = Rs ' || v_fine);\cf0\f0\fs22\par
\par
\cf3\f2\fs18     ELSE\cf0\f0\fs22\par
\cf3\f2\fs18         DBMS_OUTPUT.PUT_LINE('No fine applicable. Days less than 15.');\cf0\f0\fs22\par
\cf3\f2\fs18     END IF;\cf0\f0\fs22\par
\par
\cf3\f2\fs18     -- Change status from I to R\cf0\f0\fs22\par
\cf3\f2\fs18     UPDATE Borrower\cf0\f0\fs22\par
\cf3\f2\fs18     SET    Status = 'R'\cf0\f0\fs22\par
\cf3\f2\fs18     WHERE  Rollin     = v_rollin\cf0\f0\fs22\par
\cf3\f2\fs18       AND  NameofBook = v_bookname;\cf0\f0\fs22\par
\par
\cf3\f2\fs18     DBMS_OUTPUT.PUT_LINE('Book status updated to R (Returned).');\cf0\f0\fs22\par
\par
\cf3\f2\fs18     -- Insert into Fine only if fine > 0\cf0\f0\fs22\par
\cf3\f2\fs18     IF v_fine > 0 THEN\cf0\f0\fs22\par
\cf3\f2\fs18         INSERT INTO Fine (Roll_no, Date_, Amt)\cf0\f0\fs22\par
\cf3\f2\fs18         VALUES (v_rollin, SYSDATE, v_fine);\cf0\f0\fs22\par
\cf3\f2\fs18         DBMS_OUTPUT.PUT_LINE('Fine record inserted into Fine table.');\cf0\f0\fs22\par
\cf3\f2\fs18     END IF;\cf0\f0\fs22\par
\par
\cf3\f2\fs18     COMMIT;\cf0\f0\fs22\par
\par
\cf3\f2\fs18 EXCEPTION\cf0\f0\fs22\par
\cf3\f2\fs18     WHEN NO_DATA_FOUND THEN\cf0\f0\fs22\par
\cf3\f2\fs18         DBMS_OUTPUT.PUT_LINE('Error: No issued book found for this Roll No and Book Name.');\cf0\f0\fs22\par
\cf3\f2\fs18     WHEN OTHERS THEN\cf0\f0\fs22\par
\cf3\f2\fs18         ROLLBACK;\cf0\f0\fs22\par
\cf3\f2\fs18         DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);\cf0\f0\fs22\par
\cf3\f2\fs18 END;\cf0\f0\fs22\par
\cf3\f2\fs18 /\cf0\f0\fs22\par

