\pard\sb240\sa80\cf2\b\fs24 Step 6 \f1\emdash  \f0 Create the Stored Procedure proc_Grade\par

\pard\sb60\sa60\cf0\b0\fs22 This is the main stored procedure. It takes Name, Total_Marks, Roll as IN parameters and returns Class as OUT parameter:\par

\pard\sb60\par
\trowd\trgaph200\trrh1\trpaddl200\trpaddr200\trpaddfl3\trpaddfr3
\clcfpat13\clcbpat25\clbrdrl\brdrw20\brdrs\brdrcf2\clbrdrt\brdrw8\brdrs\brdrcf2\clbrdrr\brdrw8\brdrs\brdrcf2\clbrdrb\brdrw8\brdrs\brdrcf2 \cellx9360 
\pard\intbl\sb20\sa20\cf12\f2\fs20 CREATE OR REPLACE PROCEDURE proc_Grade(\cf0\f0\fs22\par
\cf12\f2\fs20     p_name        IN  Stud_Marks.Name%TYPE,\cf0\f0\fs22\par
\cf12\f2\fs20     p_total       IN  Stud_Marks.Total_Marks%TYPE,\cf0\f0\fs22\par
\cf12\f2\fs20     p_roll        IN  NUMBER,\cf0\f0\fs22\par
\cf12\f2\fs20     p_class       OUT VARCHAR2\cf0\f0\fs22\par
\cf12\f2\fs20 )\cf0\f0\fs22\par
\cf12\f2\fs20 AS\cf0\f0\fs22\par
\cf12\f2\fs20 BEGIN\cf0\f0\fs22\par
\cf12\f2\fs20     -- Grade categorization logic\cf0\f0\fs22\par
\cf12\f2\fs20     IF p_total <= 1500 AND p_total >= 990 THEN\cf0\f0\fs22\par
\cf12\f2\fs20         p_class := 'Distinction';\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     ELSIF p_total <= 989 AND p_total >= 900 THEN\cf0\f0\fs22\par
\cf12\f2\fs20         p_class := 'First Class';\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     ELSIF p_total <= 899 AND p_total >= 825 THEN\cf0\f0\fs22\par
\cf12\f2\fs20         p_class := 'Higher Second Class';\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     ELSE\cf0\f0\fs22\par
\cf12\f2\fs20         p_class := 'No Category / Fail';\cf0\f0\fs22\par
\cf12\f2\fs20     END IF;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20     -- Insert result into Result table\cf0\f0\fs22\par
\cf12\f2\fs20     INSERT INTO Result VALUES (p_roll, p_name, p_class);\cf0\f0\fs22\par
\cf12\f2\fs20     COMMIT;\cf0\f0\fs22\par
\cf12\f2\fs20  \cf0\f0\fs22\par
\cf12\f2\fs20 EXCEPTION\cf0\f0\fs22\par
\cf12\f2\fs20     WHEN OTHERS THEN\cf0\f0\fs22\par
\cf12\f2\fs20         DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);\cf0\f0\fs22\par
\cf12\f2\fs20 END proc_Grade;\cf0\f0\fs22\par
\cf12\f2\fs20 /\cf0\f3\fs22\cell\row 
